# Copy this file to .env and fill it in:  cp .env.example .env
#
# Only PIPELINE_API_KEY is required. Every other block switches on one more
# layer; a layer whose block is left empty is simply skipped.

# --- Access ----------------------------------------------------------------
# Shared secret. Callers send it in the X-API-Key header. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The same value goes into the Supabase function secret PIPELINE_API_KEY.
PIPELINE_API_KEY=
PIPELINE_PORT=3001
# Addresses allowed to call, comma-separated. Calls from Supabase Edge
# Functions come from changing addresses, so use * there (the key is still
# required). Default: this machine only.
PIPELINE_ALLOWED_IPS=127.0.0.1,::1,::ffff:127.0.0.1
LOG_LEVEL=info

# --- Embeddings: similarity layer (RAG) --------------------------------------
# Default provider is OpenAI (text-embedding-3-small, 1536 dimensions).
OPENAI_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536
#
# To use Gemini embeddings instead:
# EMBEDDING_API_KEY=<Gemini API key>
# EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# EMBEDDING_MODEL=gemini-embedding-2
# EMBEDDING_DIMENSIONS=1536
# (changing model or dimensions needs a new, empty Qdrant collection)

# --- Qdrant: store of known scam samples -------------------------------------
# Local Qdrant from docker-compose.yml, or a Qdrant Cloud cluster URL + API key.
# The collection is created automatically. Load the curated samples once with:
#   npm run build && npm run seed
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=phishing_emails
RAG_SIMILARITY_THRESHOLD=0.75
RAG_TOP_K=5
RAG_CANDIDATE_K=20
RERANK_ENABLED=true

# --- LLM: reasoning layer, image reading, chatbot ----------------------------
LLM_ENABLED=true
# openai (uses OPENAI_API_KEY, model gpt-4o-mini)
# gemini (uses GEMINI_API_KEY, model gemini-3.8-flash)
# custom (any OpenAI-compatible endpoint: set LLM_BASE_URL, LLM_API_KEY, LLM_MODEL)
LLM_PROVIDER=openai
GEMINI_API_KEY=
# LLM_MODEL=
# LLM_VISION_MODEL=
# always:    ask the LLM for every content that takes the deep path (needed
#            for explanations written by the model)
# gray_zone: ask it only when the other layers are undecided (score 15-74)
LLM_MODE=always
LLM_TIMEOUT_MS=10000

# --- ML service: PhoBERT / DistilBERT classifier, PaddleOCR ------------------
# See ../ml-service. With a model configured there, content the classifier is
# at least ML_CONFIDENCE_THRESHOLD sure about is answered directly.
ML_SERVICE_URL=
ML_SERVICE_API_KEY=
ML_CONFIDENCE_THRESHOLD=0.9

# --- Redis: job queue (BullMQ) and shared cache ------------------------------
# Without it, jobs run in-process and the cache lives in memory.
REDIS_URL=
QUEUE_CONCURRENCY=4
# Set a different prefix per environment when several share one Redis.
# QUEUE_PREFIX=bull

# --- Other -------------------------------------------------------------------
PIPELINE_TIMEOUT_MS=30000
CACHE_ENABLED=true
CACHE_TTL_MS=300000
