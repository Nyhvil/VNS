# Copy this file to .env and fill it in:  cp .env.example .env

# Shared secret between server and pipeline. Any long random string; put the
# same value in server/.env. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PIPELINE_API_KEY=
PIPELINE_PORT=3001
LOG_LEVEL=info

# --- Qdrant (vector database) ---------------------------------------------
# Local Qdrant from docker-compose.yml. The collection is created
# automatically the first time it is needed.
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=phishing_emails
# Only for Qdrant Cloud:
# QDRANT_API_KEY=

# --- OpenAI ---------------------------------------------------------------
# Needed for the similarity layer (embeddings), for reading images, and for
# the optional LLM layer. Without it the pipeline still runs, using only the
# rule and email-header layers.
OPENAI_API_KEY=

# Ask the LLM for a second opinion on borderline scores (costs API calls).
LLM_ENABLED=false
