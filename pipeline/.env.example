# Copy this file to .env and fill it in:  cp .env.example .env
#
# Only PIPELINE_API_KEY is required. Every other block switches on one more
# layer; a layer whose block is left empty is simply skipped.

# --- Access ----------------------------------------------------------------
# Shared secret. Callers send it in the X-API-Key header. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The same value goes into the Supabase function secret PIPELINE_API_KEY.
PIPELINE_API_KEY=
PIPELINE_PORT=3001
# Addresses allowed to call, comma-separated. Calls from Supabase Edge
# Functions come from changing addresses, so use * there (the key is still
# required). Default: this machine only.
PIPELINE_ALLOWED_IPS=127.0.0.1,::1,::ffff:127.0.0.1
LOG_LEVEL=info

# --- Embeddings: similarity layer (RAG) --------------------------------------
# Default provider is OpenAI (text-embedding-3-small, 1536 dimensions).
OPENAI_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536
#
# To use Gemini embeddings instead:
# EMBEDDING_API_KEY=<Gemini API key>
# EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# EMBEDDING_MODEL=gemini-embedding-2
# EMBEDDING_DIMENSIONS=1536
# (changing model or dimensions needs a new, empty Qdrant collection)

# --- Qdrant: store of known scam samples -------------------------------------
# Local Qdrant from docker-compose.yml, or a Qdrant Cloud cluster URL + API key.
# The collection is created automatically. Load the curated samples once with:
#   npm run build && npm run seed
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=phishing_emails
RAG_SIMILARITY_THRESHOLD=0.75
RAG_TOP_K=5
RAG_CANDIDATE_K=20
RERANK_ENABLED=true

# --- LLM: reasoning layer, image reading, chatbot ----------------------------
LLM_ENABLED=true
# openai (uses OPENAI_API_KEY, model gpt-4o-mini)
# gemini (uses GEMINI_API_KEY, model gemini-3.8-flash)
# custom (any OpenAI-compatible endpoint: set LLM_BASE_URL, LLM_API_KEY, LLM_MODEL)
LLM_PROVIDER=openai
GEMINI_API_KEY=
# LLM_MODEL=
# LLM_VISION_MODEL=
# always:    ask the LLM for every content that takes the deep path (needed
#            for explanations written by the model)
# gray_zone: ask it only when the other layers are undecided (score 15-74)
LLM_MODE=always
LLM_TIMEOUT_MS=15000
# How long "thinking" models reason before answering: low | medium | high | off.
# Default for Gemini is low (keeps answers within LLM_TIMEOUT_MS).
# LLM_REASONING_EFFORT=

# --- ML service: PhoBERT / DistilBERT classifier, PaddleOCR ------------------
# See ../ml-service. With a model configured there, content the classifier is
# at least ML_CONFIDENCE_THRESHOLD sure about is answered directly.
ML_SERVICE_URL=
ML_SERVICE_API_KEY=
ML_CONFIDENCE_THRESHOLD=0.9

# --- Redis: job queue (BullMQ) and shared cache ------------------------------
# Without it, jobs run in-process and the cache lives in memory.
REDIS_URL=
QUEUE_CONCURRENCY=4
# Set a different prefix per environment when several share one Redis.
# QUEUE_PREFIX=bull

# --- Standalone web server ---------------------------------------------------
# With WEB_ENABLED=true this process is the whole web site: it serves the web
# app (built with "npm run build:standalone" in the repository root) and
# answers /functions/v1/* itself, so no Supabase project is needed.
# Those addresses are public (no API key), so leave this off for a pipeline
# that only the Supabase functions should call. Guide: ../docs/TRIEN_KHAI.md
WEB_ENABLED=false
# Password of the /admin page. Empty = the admin page stays closed.
ADMIN_PASSWORD=
# PostgreSQL connection string (Neon, Supabase, Render, your own). Empty = the
# data is kept in files under DATA_DIR, which a host without a disk loses on
# every restart.
DATABASE_URL=
# auto | require | verify | disable   (auto: TLS for any host but this machine)
# DATABASE_SSL=auto
# DATA_DIR=./var
# Keep uploaded images so the admin page can show them.
STORE_IMAGES=true
# Proxies in front of this server (0 = reached directly). Decides which
# address the rate limit counts.
TRUSTED_PROXY_HOPS=0
# Analyses one address may ask for per window, and everyone together per minute.
RATE_LIMIT_PER_IP=20
RATE_LIMIT_WINDOW_MS=300000
RATE_LIMIT_GLOBAL_PER_MINUTE=60

# --- Accounts and paid plans (web mode) --------------------------------------
# Guests get 5 analyses a day, free accounts 10, paid plans no daily limit.
# Counters start again at 00:00 Vietnam time. See ../docs/TRIEN_KHAI.md
ACCOUNTS_ENABLED=true
# All guests behind one IP address together, per day.
GUEST_DAILY_LIMIT_PER_IP=20
# manual: an admin confirms each bank transfer on /admin.
# demo:   buyers can mark their own order paid. Presentations only.
PAYMENT_MODE=manual
PAYMENT_BANK_NAME=
PAYMENT_ACCOUNT_NUMBER=
PAYMENT_ACCOUNT_NAME=

# --- Other -------------------------------------------------------------------
# Languages Tesseract reads in images. vie and eng ship with the pipeline.
# TESSERACT_LANGS=vie+eng
PIPELINE_TIMEOUT_MS=30000
CACHE_ENABLED=true
CACHE_TTL_MS=300000
