# Copy this file to .env:  cp .env.example .env

# Shared secret. Put the same value in pipeline/.env as ML_SERVICE_API_KEY.
ML_SERVICE_API_KEY=

# --- Classifier ------------------------------------------------------------
# PhoBERT fine-tuned for Vietnamese scam detection: a Hugging Face model id or
# a local folder produced by train/train_phobert.py, e.g. ./models/phobert-scam
# There is no ready-made model: without this, Vietnamese text answers 503 and
# the pipeline simply skips the classifier.
PHOBERT_MODEL=
PHOBERT_WORD_SEGMENT=true

# DistilBERT fine-tuned for English phishing detection (optional). A public
# example: cybersectony/phishing-email-detection-distilbert_v2.4.1
DISTILBERT_MODEL=

# Only if the model's "scam" labels have unusual names (comma-separated).
# SCAM_LABELS=phishing_url,phishing_url_alt

# --- OCR (PaddleOCR) --------------------------------------------------------
OCR_ENABLED=true
OCR_LANG=vi
