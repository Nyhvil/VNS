# Copy this file to .env and fill it in:  cp .env.example .env

# --- Database -------------------------------------------------------------
# Local Postgres from docker-compose.yml:
DATABASE_URL=postgres://vns:vns_local_dev@localhost:5432/vns
# Local Postgres has no SSL. Remove this line (or set it to true) when
# DATABASE_URL points to a hosted database such as Supabase or Neon.
DATABASE_SSL=false

# --- Login tokens ---------------------------------------------------------
# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- Pipeline -------------------------------------------------------------
PIPELINE_URL=http://localhost:3001
# Must be the same value as PIPELINE_API_KEY in pipeline/.env
PIPELINE_API_KEY=

# --- Server ---------------------------------------------------------------
PORT=5000
CORS_ORIGIN=http://localhost:3000
